<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Glowing Outer Glow Aura -->
    <path
        android:pathData="M24,24m-20,0a20,20 0 1,0 40,0a20,20 0 1,0 -40,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="24"
                android:centerY="24"
                android:gradientRadius="20"
                android:type="radial">
                <item android:color="#70FFD700" android:offset="0.0"/>
                <item android:color="#30FFA500" android:offset="0.6"/>
                <item android:color="#00000000" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Golden Crown Base Base Ribbon -->
    <path
        android:pathData="M10,36 L38,36 C39.1,36 40,35.1 40,34 L40,31 C40,29.9 39.1,29 38,29 L10,29 C8.9,29 8,29.9 8,31 L8,34 C8,35.1 8.9,36 10,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="8"
                android:startY="32.5"
                android:endX="40"
                android:endY="32.5"
                android:type="linear">
                <item android:color="#FFFFE875" android:offset="0.0"/>
                <item android:color="#FFFFB300" android:offset="0.5"/>
                <item android:color="#FFFF6F00" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crown Peaks -->
    <path
        android:pathData="M8,29 L11,15 L19,23 L24,10 L29,23 L37,15 L40,29 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="24"
                android:startY="10"
                android:endX="24"
                android:endY="29"
                android:type="linear">
                <item android:color="#FFFFF1A6" android:offset="0.0"/>
                <item android:color="#FFFFC107" android:offset="0.5"/>
                <item android:color="#FFF57F17" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Imperial Jewels on Crown Peaks -->
    <path android:pathData="M11,15m-2.5,0a2.5,2.5 0 1,0 5,0a2.5,2.5 0 1,0 -5,0" android:fillColor="#FF00E5FF"/>
    <path android:pathData="M24,10m-3,0a3,3 0 1,0 6,0a3,3 0 1,0 -6,0" android:fillColor="#FFFF1744"/>
    <path android:pathData="M37,15m-2.5,0a2.5,2.5 0 1,0 5,0a2.5,2.5 0 1,0 -5,0" android:fillColor="#FF00E5FF"/>

    <!-- Center Diamond Jewel in Base -->
    <path android:pathData="M24,30.5 L27.5,32.5 L24,34.5 L20.5,32.5 Z" android:fillColor="#FFFFFF"/>

    <!-- Sparkling Star Reflection -->
    <path
        android:pathData="M35,6 L36.2,9.8 L40,11 L36.2,12.2 L35,16 L33.8,12.2 L30,11 L33.8,9.8 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M12,8 L12.8,10.2 L15,11 L12.8,11.8 L12,14 L11.2,11.8 L9,11 L11.2,10.2 Z"
        android:fillColor="#FFFFE082" />
</vector>
